+package com.reactnativeandroidwidget;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.util.Log;
+
+import com.facebook.react.bridge.BridgeReactContext;
+import com.facebook.react.bridge.JavaOnlyArray;
+import com.facebook.react.bridge.JavaOnlyMap;
+import com.facebook.react.uimanager.DisplayMetricsHolder;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.math.RoundingMode;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.text.DecimalFormat;
+import java.text.DecimalFormatSymbols;
+import java.util.Iterator;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Timely patch: widget controls that work on the phone alone, without starting
+ * the app's JavaScript. A widget's JS leaves a file with its own small state
+ * (a pomodoro's phase and lengths, say), the tree it drew for each variant of
+ * that state (light and dark) and the limits of each number. A TIMELY_LOCAL
+ * tap changes the state, saves it and redraws from those trees here, so
+ * switching a mode or changing a length is instant even when Android has
+ * closed the app. Action buttons still go to JS, which reads the same file.
+ *
+ * The file, timely-widget-local-ID.json in the app's files folder:
+ * { "state": {...}, "variantKey": "phase", "limits": { "focus": [1, 180] },
+ *   "variants": { "focus": { "light": tree, "dark": tree }, ... } }
+ * Strings in a tree may hold {{key}} (a number from the state),
+ * {{key:clock}} (minutes in the state, drawn as 25:00 or 90:00) or
+ * {{key:#,##0.00}} (a number in that DecimalFormat pattern, as a sheet
+ * counter's cell writes it). "differs": { "changed": ["count", "base"] } sets
+ * state.changed to "yes" or "no" after each tap, so a variant can follow it.
+ * A tap's data is { "set": key, "value": text } or { "step": key, "by": n }.
+ */
+public final class RNWidgetLocal {
+    public static final String CLICK = "TIMELY_LOCAL";
+    private static final String TAG = "RNWidgetLocal";
+    private static final Pattern TOKEN = Pattern.compile("\\{\\{(\\w+)(?::([^{}]+))?\\}\\}");
+
+    private RNWidgetLocal() {}
+
+    public static File file(Context context, int widgetId) {
+        return new File(context.getFilesDir(), "timely-widget-local-" + widgetId + ".json");
+    }
+
+    public static void handle(Context context, String widgetName, int widgetId, Bundle data) {
+        try {
+            File file = file(context, widgetId);
+            if (data == null || !file.exists()) return;
+            JSONObject doc = new JSONObject(new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8));
+            JSONObject state = doc.optJSONObject("state");
+            JSONObject variants = doc.optJSONObject("variants");
+            // No variants: the widget is running and JS owns every tap again.
+            if (state == null || variants == null) return;
+            if (!apply(state, doc.optJSONObject("limits"), data)) return;
+            differ(state, doc.optJSONObject("differs"));
+            try (FileOutputStream out = new FileOutputStream(file)) {
+                out.write(doc.toString().getBytes(StandardCharsets.UTF_8));
+            }
+            JSONObject trees = variants.optJSONObject(state.optString(doc.optString("variantKey", ""), ""));
+            if (trees == null || trees.optJSONObject("light") == null) return;
+            JavaOnlyMap config = new JavaOnlyMap();
+            config.putMap("light", toMap((JSONObject) fill(trees.getJSONObject("light"), state)));
+            JSONObject dark = trees.optJSONObject("dark");
+            if (dark != null) config.putMap("dark", toMap((JSONObject) fill(dark, state)));
+            else config.putNull("dark");
+            DisplayMetricsHolder.initDisplayMetricsIfNotInitialized(context);
+            new RNWidget(new BridgeReactContext(context.getApplicationContext()), config, widgetName).drawWidget(widgetId);
+        } catch (Exception e) {
+            Log.w(TAG, "Could not redraw widget " + widgetId, e);
+        }
+    }
+
+    /** Changes the state for one tap; false when nothing changed (a number at its limit). */
+    private static boolean apply(JSONObject state, JSONObject limits, Bundle data) throws Exception {
+        if (data.containsKey("set")) {
+            String key = data.getString("set");
+            String value = String.valueOf(data.get("value"));
+            if (key == null || value.equals(state.optString(key, null))) return false;
+            state.put(key, value);
+            return true;
+        }
+        if (data.containsKey("step")) {
+            String key = data.getString("step");
+            double by = number(data.get("by"));
+            if (key == null || by == 0) return false;
+            double current = state.optDouble(key, 0);
+            // Whole millionths, so 0.1 steps add up to 0.3, not 0.30000000000000004.
+            double next = Math.round((current + by) * 1e6) / 1e6;
+            JSONArray limit = limits != null ? limits.optJSONArray(key) : null;
+            if (limit != null && limit.length() == 2) next = Math.max(limit.getDouble(0), Math.min(limit.getDouble(1), next));
+            if (next == current) return false;
+            state.put(key, next);
+            return true;
+        }
+        return false;
+    }
+
+    /** Each "differs" key becomes "yes" when its two numbers in the state differ, else "no". */
+    private static void differ(JSONObject state, JSONObject differs) throws Exception {
+        if (differs == null) return;
+        for (Iterator<String> keys = differs.keys(); keys.hasNext(); ) {
+            String key = keys.next();
+            JSONArray pair = differs.optJSONArray(key);
+            if (pair == null || pair.length() != 2) continue;
+            double a = state.optDouble(pair.getString(0), 0);
+            double b = state.optDouble(pair.getString(1), 0);
+            state.put(key, Math.abs(a - b) < 1e-9 ? "no" : "yes");
+        }
+    }
+
+    private static double number(Object value) {
+        if (value instanceof Number) return ((Number) value).doubleValue();
+        try {
+            return Double.parseDouble(String.valueOf(value));
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /** A copy of a tree with every {{token}} in its strings filled in from the state. */
+    private static Object fill(Object value, JSONObject state) throws Exception {
+        if (value instanceof JSONObject) {
+            JSONObject source = (JSONObject) value;
+            JSONObject copy = new JSONObject();
+            for (Iterator<String> keys = source.keys(); keys.hasNext(); ) {
+                String key = keys.next();
+                copy.put(key, fill(source.get(key), state));
+            }
+            return copy;
+        }
+        if (value instanceof JSONArray) {
+            JSONArray source = (JSONArray) value;
+            JSONArray copy = new JSONArray();
+            for (int i = 0; i < source.length(); i++) copy.put(fill(source.get(i), state));
+            return copy;
+        }
+        if (value instanceof String && ((String) value).contains("{{")) {
+            Matcher match = TOKEN.matcher((String) value);
+            StringBuffer out = new StringBuffer();
+            while (match.find()) {
+                String text = token(state, match.group(1), match.group(2));
+                match.appendReplacement(out, Matcher.quoteReplacement(text));
+            }
+            match.appendTail(out);
+            return out.toString();
+        }
+        return value;
+    }
+
+    private static String token(JSONObject state, String key, String format) {
+        Object value = state.opt(key);
+        if (value == null) return "";
+        if (!(value instanceof Number)) return String.valueOf(value);
+        double number = ((Number) value).doubleValue();
+        // Whole minutes as a waiting clock: 25:00, 90:00.
+        if ("clock".equals(format)) return Math.round(number) + ":00";
+        if (format != null) {
+            DecimalFormat pattern = new DecimalFormat(format, DecimalFormatSymbols.getInstance(Locale.US));
+            pattern.setRoundingMode(RoundingMode.HALF_UP);
+            // No "-0" for a count back at zero.
+            return pattern.format(number == 0 ? 0.0 : number);
+        }
+        return number == Math.rint(number) ? String.valueOf((long) number) : String.valueOf(number);
+    }
+
+    /** JSON to the maps the widget builder reads (numbers as doubles, as from JS). */
+    private static JavaOnlyMap toMap(JSONObject source) throws Exception {
+        JavaOnlyMap map = new JavaOnlyMap();
+        for (Iterator<String> keys = source.keys(); keys.hasNext(); ) {
+            String key = keys.next();
+            Object value = source.get(key);
+            if (value == JSONObject.NULL) map.putNull(key);
+            else if (value instanceof JSONObject) map.putMap(key, toMap((JSONObject) value));
+            else if (value instanceof JSONArray) map.putArray(key, toArray((JSONArray) value));
+            else if (value instanceof Boolean) map.putBoolean(key, (Boolean) value);
+            else if (value instanceof Number) map.putDouble(key, ((Number) value).doubleValue());
+            else map.putString(key, value.toString());
+        }
+        return map;
+    }
+
+    private static JavaOnlyArray toArray(JSONArray source) throws Exception {
+        JavaOnlyArray array = new JavaOnlyArray();
+        for (int i = 0; i < source.length(); i++) {
+            Object value = source.get(i);
+            if (value == JSONObject.NULL) array.pushNull();
+            else if (value instanceof JSONObject) array.pushMap(toMap((JSONObject) value));
+            else if (value instanceof JSONArray) array.pushArray(toArray((JSONArray) value));
+            else if (value instanceof Boolean) array.pushBoolean((Boolean) value);
+            else if (value instanceof Number) array.pushDouble(((Number) value).doubleValue());
+            else array.pushString(value.toString());
+        }
+        return array;
+    }
+}
