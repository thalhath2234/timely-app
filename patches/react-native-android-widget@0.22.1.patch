@@ -0,0 +1,32 @@
+package com.reactnativeandroidwidget.builder;
+
+import android.view.View;
+
+import com.facebook.react.bridge.ReadableMap;
+
+/**
+ * A text area drawn by a live system Chronometer instead of the bitmap
+ * (Timely patch). Marked from JS with clickAction "CHRONOMETER" and its
+ * settings in clickActionData: base (epoch ms where the shown time is 0:00 for
+ * a stopwatch, or the end for a countdown), countDown, running, color,
+ * fontSize and gravity ("start" | "center" | "end").
+ */
+public class ChronometerView {
+    public static final String ACTION = "CHRONOMETER";
+
+    private final View view;
+    private final ReadableMap data;
+
+    ChronometerView(View view, ReadableMap data) {
+        this.view = view;
+        this.data = data;
+    }
+
+    public View getView() {
+        return view;
+    }
+
+    public ReadableMap getData() {
+        return data;
+    }
+}
