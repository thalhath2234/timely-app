+    // Timely patch: live timers. Each ChronometerView is a text area whose
+    // bitmap text is transparent; a system Chronometer ticks in its place.
+    private void addChronometers(int widgetId, RemoteViews remoteWidgetView, WidgetWithViews light, WidgetWithViews dark) {
+        remoteWidgetView.removeAllViews(R.id.rn_widget_chronometer_container);
+        List<ChronometerView> lightViews = light.getChronometerViews();
+        List<ChronometerView> darkViews = dark != null ? dark.getChronometerViews() : lightViews;
+        ViewGroup rootView = (ViewGroup) light.getRootView();
+        int widthPx = RNWidgetUtil.dpToPx(appContext, RNWidgetUtil.getWidgetWidth(appContext, widgetId));
+        int heightPx = RNWidgetUtil.dpToPx(appContext, RNWidgetUtil.getWidgetHeight(appContext, widgetId));
+        for (int i = 0; i < lightViews.size(); i++) {
+            ChronometerView lightView = lightViews.get(i);
+            ChronometerView darkView = i < darkViews.size() ? darkViews.get(i) : lightView;
+            Rect bounds = new Rect();
+            lightView.getView().getDrawingRect(bounds);
+            rootView.offsetDescendantRectToMyCoords(lightView.getView(), bounds);
+
+            RemoteViews chronometer = new RemoteViews(appContext.getPackageName(), R.layout.rn_widget_chronometer);
+            String gravity = stringOr(lightView.getData(), "gravity", "start");
+            chronometer.setViewPadding(
+                R.id.rn_widget_chronometer_positioner,
+                bounds.left,
+                bounds.top,
+                "start".equals(gravity) ? 0 : Math.max(0, widthPx - bounds.right),
+                Math.max(0, heightPx - bounds.bottom)
+            );
+            setUpChronometer(chronometer, R.id.rn_widget_chronometer_light, lightView.getData(), gravity);
+            setUpChronometer(chronometer, R.id.rn_widget_chronometer_dark, darkView.getData(), gravity);
+            remoteWidgetView.addView(R.id.rn_widget_chronometer_container, chronometer);
+        }
+    }
+
+    private void setUpChronometer(RemoteViews views, int id, ReadableMap data, String gravity) {
+        double baseEpoch = data.hasKey("base") ? data.getDouble("base") : System.currentTimeMillis();
+        long base = SystemClock.elapsedRealtime() + (long) (baseEpoch - System.currentTimeMillis());
+        boolean running = data.hasKey("running") && data.getBoolean("running");
+        views.setChronometer(id, base, null, running);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            views.setChronometerCountDown(id, data.hasKey("countDown") && data.getBoolean("countDown"));
+        }
+        if (data.hasKey("fontSize")) {
+            views.setTextViewTextSize(id, TypedValue.COMPLEX_UNIT_DIP, (float) data.getDouble("fontSize"));
+        }
+        try {
+            views.setTextColor(id, Color.parseColor(stringOr(data, "color", "#000000")));
+        } catch (IllegalArgumentException ignored) {
+            // Keep the default text colour.
+        }
+        int horizontal = "center".equals(gravity) ? Gravity.CENTER_HORIZONTAL : "end".equals(gravity) ? Gravity.END : Gravity.START;
+        views.setInt(id, "setGravity", horizontal | Gravity.CENTER_VERTICAL);
+    }
+
+    private static String stringOr(ReadableMap data, String key, String fallback) {
+        return data != null && data.hasKey(key) && !data.isNull(key) ? data.getString(key) : fallback;
+    }
