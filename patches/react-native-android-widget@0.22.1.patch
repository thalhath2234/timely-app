diff --git a/android/src/main/res/layout/rn_widget_chronometer.xml b/android/src/main/res/layout/rn_widget_chronometer.xml
new file mode 100644
index 0000000000000000000000000000000000000000..5e7fccd38097287434b96f6073a6e8cc0420ac21
--- /dev/null
+++ b/android/src/main/res/layout/rn_widget_chronometer.xml
@@ -0,0 +1,66 @@
+<!--
+  Timely patch: a live timer placed by proportion, not by pixel padding. Some
+  launchers (HyperOS) scale the padding a widget sets by its own factor (0.78)
+  while the widget image stays 1:1, so pixel-placed areas drifted off the
+  buttons they belonged to. Each LinearLayout's weightSum is set from code so
+  that its single weighted child covers the right fraction of the widget:
+  rows 0..bottom, then top..bottom, then columns 0..right, then left..right.
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/rn_widget_place_to_bottom"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:orientation="vertical">
+
+    <LinearLayout
+        android:id="@+id/rn_widget_place_from_top"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:gravity="bottom"
+        android:orientation="vertical">
+
+        <LinearLayout
+            android:id="@+id/rn_widget_place_to_right"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1"
+            android:orientation="horizontal">
+
+            <LinearLayout
+                android:id="@+id/rn_widget_place_from_left"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:gravity="end"
+                android:orientation="horizontal">
+
+                <FrameLayout
+                    android:layout_width="0dp"
+                    android:layout_height="match_parent"
+                    android:layout_weight="1">
+
+                    <Chronometer
+                        android:id="@+id/rn_widget_chronometer_light"
+                        android:layout_width="match_parent"
+                        android:layout_height="match_parent"
+                        android:fontFamily="sans-serif-condensed"
+                        android:includeFontPadding="false"
+                        android:maxLines="1"
+                        android:textStyle="bold"
+                        android:visibility="visible" />
+
+                    <Chronometer
+                        android:id="@+id/rn_widget_chronometer_dark"
+                        android:layout_width="match_parent"
+                        android:layout_height="match_parent"
+                        android:fontFamily="sans-serif-condensed"
+                        android:includeFontPadding="false"
+                        android:maxLines="1"
+                        android:textStyle="bold"
+                        android:visibility="gone" />
+                </FrameLayout>
+            </LinearLayout>
+        </LinearLayout>
+    </LinearLayout>
+</LinearLayout>
