# Single env file for the whole monorepo. Copy to .env (git-ignored) at the
# repo root; `make setup` does this. The API, the web app, the mobile app, the
# Makefile and docker-compose all read this one file.

# ---- Shared ----

# Signs sessions in the API and verifies them in the web app, so both must see
# the same value. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret

# ---- API (apps/api) ----

# Database Configuration
# These environment variables are used for both application connection and Goose migrations
DB_HOST=localhost
DB_PORT=5432
DB_USER=timely
DB_PASSWORD=root123
DB_NAME=timely_db
DB_SSLMODE=disable

# Port the API listens on.
API_PORT=8080
# Comma-separated hosts the API listens on. Default: loopback only. The packaged
# desktop app adds the host's Tailscale addresses when "Tailscale access" is on.
# Use 0.0.0.0 only on a server you deliberately expose.
# API_BIND=127.0.0.1

# Only the first account can sign up unless this is true (Settings → Server
# toggles this in the desktop app).
# ALLOW_REGISTRATION=false

# Root for everything the API writes (backups, chat images). Relative
# TIMELY_BACKUP_DIR / CHAT_IMAGE_DIR values resolve under it. The desktop app sets
# it to its user-data folder.
# TIMELY_DATA_DIR=

# Extra browser origins allowed to call the API directly (comma separated).
# The web app proxies through its own origin, so this is rarely needed.
# CORS_ORIGINS=
# Extra hosts the Next.js dev server accepts (e.g. an ngrok tunnel), comma-separated.
# DEV_ORIGINS=

# Stable secret used for AES-256-GCM server backups. Keep it safe: changing it
# makes existing encrypted backups unreadable. Falls back to JWT_SECRET.
TIMELY_BACKUP_KEY=replace-with-a-separate-random-secret
TIMELY_BACKUP_DIR=data/backups
# Short-lived access tokens. Refresh tokens last JWT_REFRESH_DAYS.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
# Legacy alias used only if JWT_ACCESS_MINUTES is unset.
# JWT_EXPIRY_HOURS=24

# OpenRouter embeddings (semantic search). Keyword search still works without this.
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Optional: run this instance in its own PostgreSQL schema (tables, migrations,
# workers). Useful for a worktree API on :8081 that must not share chat runs or
# jobs with the main checkout on :8080.
# DB_SCHEMA=wt_feature

# Migration Configuration (optional)
# Uncomment to configure migration behavior:
# MIGRATION_TIMEOUT=10s
# MIGRATION_LOCK_TIMEOUT=5s

# In-app chat model (uses the server OPENROUTER_API_KEY above). Each account can
# override the key and model from Settings → Agent; these are the fallbacks.
OPENROUTER_CHAT_MODEL=z-ai/glm-5.3-flash

# Agent providers found on this host. Settings → Agent can connect the Claude Code
# and Codex CLIs installed and signed in for the OS user running the API. Set
# CHAT_LOCAL_CLI=off to hide them on a shared instance. The UI never takes a
# path; use these when the binaries live outside PATH and the usual install dirs.
# CHAT_LOCAL_CLI=off
# CLAUDE_BIN=/home/me/.local/bin/claude
# CODEX_BIN=/home/me/.local/bin/codex

# Direct API providers (Anthropic, OpenAI, Gemini, DeepSeek, …) take their keys in
# Settings → Agent, per account; there are no server-wide keys for them. Ollama's
# default address is http://localhost:11434; override it here when Ollama runs
# elsewhere (each account can still pick another address in the UI). Timely asks
# Ollama for a 32k context window so the assistant's instructions fit; lower it
# with OLLAMA_NUM_CTX on a small GPU (the assistant may then lose instructions).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# Optional dedicated private temporary directory for chat images (not backed up).
# Default: OS temporary directory / timely-chat-images. Never expose publicly.
CHAT_IMAGE_DIR=

# ---- Web (apps/web) ----

# Where /api-proxy/* requests are rewritten to (see next.config.ts).
# API_ORIGIN=http://localhost:8080

# Public address of the web app, read at build time. Link previews of the
# landing page need it to point at the preview image; without it they use
# http://localhost.
# SITE_URL=https://timely.example.com

# ---- Mobile (apps/mobile) ----

# Optional. Development-only base URL of the Timely API, without a trailing
# slash, used by Expo Go and emulator builds. Release builds do not need it:
# the phone pairs with a server at runtime (scan the QR in Settings → Server).
#
# Android emulator (maps to the host's localhost): http://10.0.2.2:8080
# iOS simulator / web:                             http://localhost:8080
# Physical phone on the same Wi-Fi:                http://<your-pc-lan-ip>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
