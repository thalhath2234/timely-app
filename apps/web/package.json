{
  "name": "@timely/web",
  "version": "0.1.3",
  "private": true,
  "description": "Private personal planning, scheduling, and notes.",
  "author": "Timely",
  "productName": "Timely",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "electron:compile": "node electron/build.mjs",
    "electron:dev": "node electron/dev.mjs",
    "electron:open": "node electron/wait-and-launch.mjs",
    "electron:stage": "node electron/stage-api.mjs && node electron/stage-postgres.mjs",
    "electron:hosted": "node electron/hosted.mjs",
    "electron:pack": "node electron/pack.mjs --dir",
    "electron:dist": "node electron/pack.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.100.13",
    "@timely/contract": "workspace:*",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.3",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "electron": "^44.1.1",
    "electron-builder": "^26.16.0",
    "esbuild": "^0.25.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "electron-winstaller",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
