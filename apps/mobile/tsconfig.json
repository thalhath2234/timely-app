{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@timely/contract": [
        "../../packages/contract/src/index.ts"
      ],
      "@timely/contract/*": [
        "../../packages/contract/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
