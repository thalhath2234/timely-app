# Copy this file to .env.local for development. Base URL of the Timely API,
# without a trailing slash. app.config.js and `make build-apk` load .env.local
# before falling back to the legacy .env file.
#
# Android emulator (maps to the host's localhost): http://10.0.2.2:8080
# iOS simulator / web:                             http://localhost:8080
# Physical phone on the same Wi-Fi:                http://<your-pc-lan-ip>:8080
# Remote tunnel (ngrok etc.):                      https://xxxx.ngrok-free.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
